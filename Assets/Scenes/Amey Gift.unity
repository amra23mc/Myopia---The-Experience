  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Lieber Amey,\n\nDu hast bei Warschau einen heldenhaften Kampf gefochten.
    Tats\xE4chlich hast du die Schlacht f\xFCr uns im Alleingang gewonnen. Da du
    jedoch schwere Kopfverletzungen erlitten hast, musstest du monatelang im Krankenhaus
    liegen. Wenn du dies liest, sei dankbar daf\xFCr, dass du \xFCberlebt hast. Auf
    dem Tisch zu deiner Linken liegt ein kleines Geschenk von uns. Betrachte es als
    Ausdruck unserer Dankbarkeit.\n\nGr\xFC\xDFe, Hitler"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
